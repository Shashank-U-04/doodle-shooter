{
  "private": true,
  "name": "doodle-shooter-server",
  "version": "0.1.0",
  "description": "Doodle Shooter multiplayer server (Colyseus)",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "serve": "node build/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "mocha -r tsx \"test/**/*.test.ts\" --exit --timeout 15000",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:hosted": "tsx scripts/check-hosted.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.72.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.2",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  }
}
