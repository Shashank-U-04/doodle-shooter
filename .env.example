# The game starts without any Convex variable. Convex is only used by the
# legacy PeerJS transport, to fetch TURN relay credentials.
#
# Convex HTTP-actions origin, used for GET <site>/turn (TURN credentials).
# Production shape: https://<deployment>.convex.site
VITE_CONVEX_SITE_URL=

# Convex deployment URL (https://<deployment>.convex.cloud). Only read to
# derive VITE_CONVEX_SITE_URL when that is unset; set the site URL instead.
VITE_CONVEX_URL=

# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Signaling broker (PeerJS). Unset = the public PeerJS cloud broker
# (wss://0.peerjs.com:443/). Point these at your own PeerServer if the public
# broker is blocked or rate-limited on your players' networks.
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_KEY=
VITE_PEER_SECURE=

# Optional: set to 1 to log ICE gathering, candidate types and the selected pair.
VITE_NET_DEBUG=

# Optional, preview: set VITE_NET_TRANSPORT=colyseus to run the online lobby on
# the Colyseus match server (server/) instead of PeerJS. Unset keeps PeerJS.
VITE_NET_TRANSPORT=
# Match server URL for the Colyseus lobby. Development builds default to
# http://localhost:2567; a production build must set it.
VITE_COLYSEUS_URL=

# Server-side only (set on the CONVEX deployment, never here):
#   TURN_URLS="turn:relay.example.com:3478,turns:relay.example.com:443?transport=tcp"
#   TURN_SECRET="<relay static-auth-secret>"
#   TURN_TTL=3600
#   TURN_ALLOWED_ORIGINS="https://yourgame.vercel.app"
